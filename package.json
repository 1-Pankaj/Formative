{
  "name": "formative",
  "version": "1.0.0",
  "description": "Desktop-first project workspace for diagrams, tasks, and agent transcript review",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:website": "vite -c vite.website.config.ts",
    "build": "tsc && vite build",
    "build:website": "vite build -c vite.website.config.ts",
    "preview:website": "vite preview -c vite.website.config.ts",
    "test": "vitest run",
    "start": "electron .",
    "desktop": "tsc && vite build && electron .",
    "dist": "tsc && vite build && electron-builder --win",
    "dist:installer": "tsc && vite build && electron-builder --win nsis",
    "dist:portable": "tsc && vite build && electron-builder --win portable",
    "dist:dir": "tsc && vite build && electron-builder --win --dir"
  },
  "keywords": [
    "architecture",
    "ai-agent",
    "telemetry",
    "workflow",
    "canvas",
    "formative",
    "claude-code",
    "antigravity",
    "opencode",
    "codex"
  ],
  "author": "Formative Open Source Community",
  "license": "MIT",
  "build": {
    "appId": "dev.formative.studio",
    "productName": "Formative",
    "directories": {
      "output": "build-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico",
      "public/assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "llm/formativellm.gguf",
        "to": "llm/formativellm.gguf"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Formative"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@types/three": "^0.160.0",
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.10",
    "node-llama-cpp": "^3.22.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
