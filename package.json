{
  "name": "formative",
  "version": "1.0.0",
  "description": "Desktop-first project workspace for diagrams, tasks, and agent transcript review",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:website": "vite -c vite.website.config.ts",
    "build": "tsc && vite build",
    "build:website": "vite build -c vite.website.config.ts",
    "preview:website": "vite preview -c vite.website.config.ts",
    "test": "vitest run",
    "start": "electron .",
    "desktop": "tsc && vite build && electron .",
    "dist": "tsc && vite build && electron-builder --config electron-builder.config.cjs --win",
    "dist:installer": "tsc && vite build && electron-builder --config electron-builder.config.cjs --win nsis",
    "dist:portable": "tsc && vite build && electron-builder --config electron-builder.config.cjs --win portable",
    "dist:dir": "tsc && vite build && electron-builder --config electron-builder.config.cjs --win --dir"
  },
  "keywords": [
    "architecture",
    "ai-agent",
    "telemetry",
    "workflow",
    "canvas",
    "formative",
    "claude-code",
    "antigravity",
    "opencode",
    "codex"
  ],
  "author": "Formative Open Source Community",
  "license": "MIT",
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "@types/three": "^0.160.0",
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "framer-motion": "^12.4.10",
    "node-llama-cpp": "^3.22.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
