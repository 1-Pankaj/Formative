# ==============================================================================
# Formative Studio - Comprehensive .gitignore
# Prevents sensitive credentials, caches, large binaries, and external folders
# from ever being committed to GitHub.
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production & Build Outputs
dist/
dist-ssr/
build-release/
release/
out/
win-unpacked/
*.local
*.asar

# Executables, Packages & Compressed Binaries
*.exe
*.dll
*.so
*.dylib
*.dmg
*.pkg
*.deb
*.rpm
*.zip
*.tar.gz
*.tgz
*.7z
*.msi

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.pfx
*.p12
*.cer
*.der
id_rsa*
*.secret
*.token
credentials.json
service-account*.json

# External Reference Codebases & Temporary Clones
munder-difflin-main/
paperclip-master/
paperclip-master.zip
archive/

# Knowledge Graph & Semantic Extraction Cache
graphify-out/
.graphify/
*.graphify*

# Logs, Dumps & Temp Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
.tmp/
.temp/
.cache/
.eslintcache
.stylelintcache

# OS-Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor & IDE Directories
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
